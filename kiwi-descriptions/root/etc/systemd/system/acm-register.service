[Unit]
Description=ACM controller discovery and node registration
Documentation=https://github.com/heatmiser/openshift-acm-app-of-apps
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/acm-register.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/acm-register.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
