<!--
  MinLiveBoot Profile

  Minimal live boot configuration for automation use cases.
  Replaces LiveInstall for MIN-Live-Automation profile.

  Purpose: Bootable live ISO without Anaconda installer
  Benefits:
    - Smaller ISO (~200-250 MB reduction)
    - Faster boot (no installer overhead)
    - Reduced attack surface
    - Clear automation-only intent

  Includes: Essential live packages, kernel, bootloader, mediacheck
  Excludes: anaconda, glibc-all-langpacks, installer environment
-->
<image>
	<profiles>
		<profile name="MinLiveBoot" description="Minimal Live Boot (no installer)">
			<requires profile="BootCore"/>
		</profile>
	</profiles>
	<preferences profiles="MinLiveBoot">
		<type image="iso" publisher="CentOS AltImages SIG" volid="CentOS_AltImage" primary="true" flags="dmsquash"
			filesystem="erofs" erofscompression="lzma,level=9"
			firmware="uefi" efifatimagesize="30" kernelcmdline="quiet rhgb" mediacheck="true"
		>
			<bootloader name="grub2" grub_template="grub.cfg.iso-template" console="console" timeout="60"/>
		</type>
	</preferences>
	<packages type="iso" patternType="plusRecommended" profiles="MinLiveBoot">
		<!-- Essential live boot packages (NO installer) -->
		<package name="dracut-live"/>
		<package name="glibc-langpack-en"/>
		<package name="isomd5sum"/>
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="livesys-scripts"/>
		<ignore name="gfs2-utils"/>
	</packages>
</image>
